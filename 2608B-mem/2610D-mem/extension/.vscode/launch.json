{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CUDA-GDB",
            "type": "cuda-gdb",
            "request": "launch",
            "program": "${workspaceFolder}/build/test",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "CMake",
            "internalConsoleOptions": "openOnSessionStart"
        },
        {
            "name": "GDB",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/test",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "CMake",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "externalConsole": false,
            "internalConsoleOptions": "openOnSessionStart"
        }
    ]
}

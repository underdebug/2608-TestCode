{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug C++ shader demo (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/shader_cpp_demo",
            "cwd": "${workspaceFolder}",
            "args": [],
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "CMake: build",
            "internalConsoleOptions": "openOnSessionStart",
            "console": "internalConsole",
            "redirectOutput": true
        }
    ]
}

{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake",
            "type": "shell",
            "command": "cmake -S . -B \"${workspaceFolder}/../../../build/${workspaceFolderBasename}\" -DCMAKE_BUILD_TYPE=Debug && cmake --build \"${workspaceFolder}/../../../build/${workspaceFolderBasename}\" --config Debug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc",
                "$nvcc"
            ]
        }
    ]
}

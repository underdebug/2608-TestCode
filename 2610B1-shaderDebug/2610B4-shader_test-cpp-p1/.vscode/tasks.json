{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build NURBS CPU demo",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/main.py",
                "--build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
